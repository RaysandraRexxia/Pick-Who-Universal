; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pick Who Universal"
config/description="Inspired by the popular game of guessing characters, use your own images to create any guessing game!"
config/version="1.0"
run/main_scene="uid://d3ulq7xap5l3i"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/image="uid://dlq1a1ss46r7s"
config/icon="uid://qfb1m4eno418"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[gui]

theme/default_font_generate_mipmaps=true

