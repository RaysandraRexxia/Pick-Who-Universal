[node name="GameTurnText" type="Label" parent="MarginContainer/VBoxContainer/TurnHBox" unique_id=1571974276]
layout_mode = 2
text = "1) Choose an opponent.
2) Ask that player a yes or no question about their character.
3) They answer \"Yes\" or \"No\".
4) Flip your tiles facedown if you think those characters are NOT their character.
5) The next player clock-wise takes a turn."

