text = "Guessing:   "

[node name="GuessText" type="Label" parent="MarginContainer/VBoxContainer/GuessHBox" unique_id=528786251]
layout_mode = 2
text = "Instead of taking a normal turn, you may choose an opponent and make a guess on
which character they have. There are a couple possible outcomes:
-> Correct Guess: That player is eliminated from the game. If you are the last player, you win!
-> Wrong Guess: You are eliminated from the game!"

